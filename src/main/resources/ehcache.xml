<?xml version="1.0" encoding="UTF-8"?>

<config
    xmlns="http://www.ehcache.org/v3"
    xmlns:jsr107="http://www.ehcache.org/v3/jsr107">

    <!-- UserAgent L2 Cache -->
    <cache alias="userAgentCache">

        <key-type>java.lang.Long</key-type>

        <value-type>
            com.Real_time_analytics_reporting_dashboard.Entity.UserAgent
        </value-type>

        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>

        <resources>
            <heap unit="entries">100</heap>
        </resources>

    </cache>


    <!-- Geolocation L2 Cache -->
    <cache alias="geolocationCache">

        <key-type>java.lang.Long</key-type>

        <value-type>
            com.Real_time_analytics_reporting_dashboard.Entity.Geolocation
        </value-type>

        <expiry>
            <ttl unit="minutes">30</ttl>
        </expiry>

        <resources>
            <heap unit="entries">100</heap>
        </resources>

    </cache>


    <!-- Hibernate Query Cache -->
    <cache alias="default-query-results-region">

        <key-type>java.lang.Object</key-type>

        <value-type>java.lang.Object</value-type>

        <expiry>
            <ttl unit="minutes">5</ttl>
        </expiry>

        <resources>
            <heap unit="entries">1000</heap>
        </resources>

    </cache>


    <!-- Hibernate Timestamp Cache -->
    <cache alias="default-update-timestamps-region">

        <key-type>java.lang.Object</key-type>

        <value-type>java.lang.Object</value-type>

        <expiry>
            <ttl unit="minutes">5</ttl>
        </expiry>

        <resources>
            <heap unit="entries">1000</heap>
        </resources>

    </cache>

</config>